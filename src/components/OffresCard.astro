---
import PbImage from '../components/pbImage.astro';

const { offre } = Astro.props;
---

<div class="card bg-base-100 border border-primary shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden">

  <!-- Image -->
  <figure class="relative">

    <PbImage
      record={offre}
      recordImage={offre.image[0]}
      width={900}
      height={300}
      class="w-full h-48 md:h-56 object-cover hover:scale-105 transition-transform duration-500"
    />

    <!-- Badge favori -->
    {offre.favori && (
      <div class="absolute top-3 right-3 badge badge-error text-error-content">
        ❤️ Favori
      </div>
    )}

  </figure>


  <!-- Contenu -->
  <div class="card-body">

    <div class="flex items-start gap-2">

      <h2 class="card-title text-primary">
        {offre.nom_maison}
      </h2>

      <!-- Bouton favori -->
      <button
        class="favoriteButton btn btn-ghost btn-circle ml-auto"
        data-offre={JSON.stringify(offre)}
        aria-label="Ajouter aux favoris"
      >

        <img
          id="favorite-icon"
          src={offre.favori
            ? "/favorite_filled.png"
            : "/favorite.png"}
          alt="Favori"
          class="w-6 h-6 pointer-events-none"
        />

      </button>

    </div>


    <!-- Adresse -->
    <p class="text-base-content/70">
      📍 {offre.adresse_complete}
    </p>


    <!-- Badges -->
    <div class="flex flex-wrap gap-2 mt-2">

      <div class="badge badge-primary">
        {offre.surface} m²
      </div>

      <div class="badge badge-secondary">
        {offre.nombre_chambre} chambres
      </div>

      <div class="badge badge-accent">
        {offre.nombre_salle_de_bain} salles de bain
      </div>

    </div>


    <!-- Prix -->
    <div class="mt-3">

      <span class="text-2xl font-bold text-success">
        {offre.prix} €
      </span>

    </div>


    <!-- Action -->
    <div class="card-actions justify-end mt-4">

      <a
        href={`/offres/${offre.id}`}
        class="btn btn-primary text-primary-content w-full sm:w-auto"
      >
        Voir plus
      </a>

    </div>

  </div>

</div>


<script>
  //@ts-nocheck

  import { setFavori } from "../backend.mjs";

  const favoriteButtons =
    document.querySelectorAll(".favoriteButton");

  favoriteButtons.forEach(button => {

    button.addEventListener("click", async () => {

      const offreData = JSON.parse(
        button.dataset.offre || "{}"
      );

      const newFavori = !offreData.favori;

      await setFavori(offreData);

      const favIcon =
        button.querySelector("#favorite-icon");

      if (favIcon) {
        favIcon.src = newFavori
          ? "/favorite_filled.png"
          : "/favorite.png";
      }

      offreData.favori = newFavori;

      button.dataset.offre =
        JSON.stringify(offreData);

    });

  });
</script>