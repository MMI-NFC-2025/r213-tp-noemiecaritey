---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro";
import OffresCard from "../components/OffresCard.astro";
import { getOffres } from "../backend.mjs";
import Header from "../components/Header.astro";

// Récupère les offres
const dernieresOffres = await getOffres();
---

<Layout title="Accueil">

  <div class="max-w-6xl mx-auto px-4 py-16">

    <!-- Titre et bouton principal -->
    <div class="text-center mb-12">

      <h1 class="text-4xl font-bold text-primary mb-4">
        🏠 Nos offres immobilières
      </h1>

      <a
        href="/offres"
        class="btn btn-primary text-primary-content"
      >
        Voir toutes les offres →
      </a>

    </div>

    <!-- Message d'information -->
    <div class="alert alert-info text-info-content mb-6">
      Découvrez nos dernières offres immobilières.
    </div>

    <!-- Message de succès : exercice DaisyUI -->
    <div class="alert alert-success text-success-content mb-6">
      Opération réussie !
    </div>

    <!-- Message d'erreur : exercice DaisyUI -->
    <div class="alert alert-error text-error-content mb-8">
      Une erreur est survenue.
    </div>

    <!-- 3 dernières offres -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      {dernieresOffres.slice(0, 3).map((offre) => (
        <OffresCard offre={offre} />
      ))}

    </div>

    <!-- Lien vers toutes les offres -->
    <div class="text-center mt-12">

      <a
        href="/offres"
        class="text-secondary hover:underline font-medium text-lg"
      >
        Toutes les offres →
      </a>

    </div>

  </div>

</Layout>