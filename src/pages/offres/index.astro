---
import '../styles/global.css';
import Layout from "../../layouts/Layout.astro";
import OffresCard from "../../components/OffresCard.astro";
import Header from "../../components/Header.astro";
import { getOffres } from "../../backend.mjs";

const offres = await getOffres();
---

<Layout title="Nos offres">

  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-10">

      <div>
        <div class="badge badge-primary mb-3">
          Immobilier
        </div>

        <h1 class="text-4xl font-bold text-primary">
          Toutes nos offres
        </h1>

        <p class="text-base-content/70 mt-2">
          Retrouvez l'ensemble de nos biens disponibles.
        </p>
      </div>

      <a
        href="/add"
        class="btn btn-primary text-primary-content"
      >
        + Ajouter une offre
      </a>

    </div>


    <div class="alert alert-success text-success-content mb-8">
      <span>
        {offres.length} offre(s) disponible(s)
      </span>
    </div>


    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

      {offres.map((offre) => (
        <OffresCard offre={offre} />
      ))}

    </div>

  </main>

</Layout>

---

<Layout title="Offres">
  <h1 class="text-2xl font-bold mb-6">Offres disponibles</h1>

  <a 
  href="offres/add" 
  class="inline-block mb-5 px-5 py-2 bg-orange-500 text-white font-medium rounded-md shadow-sm hover:bg-orange-600 transition duration-200"
>
  + Ajouter une offre
</a>

  <form 
  action="/offres" 
  method="POST"
  class="flex flex-col gap-4 max-w-md p-4 border rounded-lg shadow-sm bg-gray-50"
>
  <input 
    type="number" 
    name="minPrix" 
    placeholder="Prix minimum"
    class="border p-2 rounded-md"
  />

  <input 
    type="number" 
    name="maxPrix" 
    placeholder="Prix maximum"
    class="border p-2 rounded-md"
  />

  <select
    name="agentId"
    class="border p-2 rounded-md"
  >
    <option value="">
      -- Filtrer par agent (optionnel) --
    </option>

    {agents?.map((agent) => (
      <option
        value={agent.id}
        selected={selectedAgentId === String(agent.id)}
      >
        {agent.Nom}
      </option>
    ))}
  </select>

  <input 
    type="submit" 
    value="Filtrer"
    class="bg-orange-600 text-white p-2 rounded-md hover:bg-orange-700 cursor-pointer"
  />
</form>

  <div class="flex gap-4 mb-6">
    <a href="/offres/surface/80" class="text-blue-600 hover:underline font-medium">< 80 m²</a>
    <a href="/offres/prix/500000" class="text-green-600 hover:underline font-medium"> >500k €</a>
  </div>
  
  <button id="favori-button" class="bg-gray-800 text-white px-6 py-2 rounded hover:bg-gray-900 mb-6">Afficher les favoris</button>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {offres?.map((offre) => 
      <div class="offre" data-favori={offre.favori.toString()}>
        <OffreCard offre={offre} />
      </div>
    )}
  </div>
</Layout>

<script>
    //@ts-nocheck
    const button = document.getElementById('favori-button');
    let showOnlyFavorites = false;
    
    button?.addEventListener('click', () => {
        showOnlyFavorites = !showOnlyFavorites;
        const offres = document.querySelectorAll('.offre');
        
        offres.forEach(offre => {
            const isFavori = offre.dataset.favori === 'true';
            
            if (showOnlyFavorites) {
                offre.style.display = isFavori ? '' : 'none';
                button.textContent = 'Afficher tout';
            } else {
                offre.style.display = '';
                button.textContent = 'Afficher les favoris';
            }
        });
    });
</script>


